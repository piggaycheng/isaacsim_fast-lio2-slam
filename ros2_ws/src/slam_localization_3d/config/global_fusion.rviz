Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Tool Properties
    Name: Tool Properties
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Enabled: true
      Name: Grid
      Plane: XY
      Reference Frame: <Fixed Frame>
    - Alpha: 0.7
      Class: rviz_default_plugins/Map
      Color Scheme: map
      Enabled: true
      Name: Office PGM
      Topic:
        Depth: 5
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /map
    - Alpha: 0.5
      Class: rviz_default_plugins/Map
      Color Scheme: costmap
      Enabled: true
      Name: Global costmap (optional)
      Topic:
        Depth: 5
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /global_costmap/costmap
    - Alpha: 0.75
      Class: rviz_default_plugins/Map
      Color Scheme: costmap
      Enabled: true
      Name: Local costmap (optional)
      Topic:
        Depth: 5
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /local_costmap/costmap
    - Alpha: 1
      Buffer Length: 1
      Class: rviz_default_plugins/Path
      Color: 0; 255; 150
      Enabled: true
      Line Style: Lines
      Line Width: 0.04
      Name: Nav2 planned path (navigate mode)
      Pose Style: None
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /plan
    - Alpha: 1
      Class: rviz_default_plugins/Polygon
      Color: 255; 0; 0
      Enabled: true
      Name: Collision monitor stop zone (navigate mode)
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /collision_monitor/polygon_stop
    - Alpha: 1
      Class: rviz_default_plugins/Polygon
      Color: 255; 0; 150
      Enabled: true
      Name: Collision monitor surround stop zone (navigate mode)
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /collision_monitor/polygon_surround
    - Alpha: 1
      Class: rviz_default_plugins/Polygon
      Color: 255; 170; 0
      Enabled: true
      Name: Collision monitor slowdown zone (navigate mode)
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /collision_monitor/polygon_slowdown
    - Class: rviz_default_plugins/PoseWithCovariance
      Covariance:
        Orientation:
          Value: false
        Position:
          Value: false
        Value: false
      Enabled: true
      Name: Accepted PCD Position
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /localization_3d/global_pose
    - Class: rviz_default_plugins/LaserScan
      Color: 255; 64; 32
      Decay Time: 0
      Enabled: true
      Name: Height-filtered obstacles
      Size (Pixels): 3
      Style: Points
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /scan
    - Class: rviz_default_plugins/PointCloud2
      Color: 54; 207; 84
      Color Transformer: FlatColor
      Enabled: false
      Name: 3D ground-filtered obstacles (optional)
      Size (Pixels): 2
      Style: Points
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /perception/obstacles
    - Class: rviz_default_plugins/TF
      Enabled: true
      Frame Timeout: 5
      Name: TF
      Show Arrows: false
      Show Axes: true
      Show Names: true
    - Class: rviz_default_plugins/InteractiveMarkers
      Enabled: true
      Name: Costmap zone editor (optional)
      Show Descriptions: true
      Interactive Markers Namespace: /costmap_filter_editor
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/SetInitialPose
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /initialpose
    - Class: rviz_default_plugins/SetGoal
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /goal_pose
    - Class: rviz_default_plugins/PublishPoint
      Single click: false
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /clicked_point
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 23
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Name: Current View
      Pitch: 1.3
      Target Frame: map
      Yaw: 0
      Value: Orbit (rviz)
Window Geometry:
  Height: 900
  Width: 1440

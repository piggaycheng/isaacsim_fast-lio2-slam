# Rotate the pan/tilt gimbal to an absolute pose (rad). Pan takes the shortest way round.
float64 pan
float64 tilt
---
# success is true only after the measured pose matches the goal within tolerance.
bool success
string message
float64 pan
float64 tilt
---
# Current measured pose and remaining (wrapped) error.
float64 pan
float64 tilt
float64 pan_error
float64 tilt_error
